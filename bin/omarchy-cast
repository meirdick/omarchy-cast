#!/usr/bin/env bash
# Cast a local file to a device, from a shell or a file manager's "Open with".
#
#   omarchy-cast video.mp4              # to whichever device is playing, or the only one
#   omarchy-cast video.mp4 "Den TV"     # to a named device
#   omarchy-cast --stop                 # stop, and close the socket serving it
#   omarchy-cast --list                 # what is on the network
#
# This is a thin wrapper over the plugin's IPC. The widget does the work.
set -euo pipefail

usage() {
  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

case "${1:-}" in
  -h|--help) usage 0 ;;
  --list) omarchy-shell meirdick.cast devices; exit 0 ;;
  --stop) omarchy-shell meirdick.cast stopCast "${2:-}"; exit 0 ;;
  --serving) omarchy-shell meirdick.cast serving; exit 0 ;;
  "") usage 1 ;;
esac

file="$1"
device="${2:-}"

if [ ! -f "$file" ]; then
  echo "omarchy-cast: not a file: $file" >&2
  exit 1
fi

# The helper needs an absolute path; it is opened by the serving process, not
# by this shell, and that process has a different working directory.
file="$(realpath "$file")"

omarchy-shell meirdick.cast castFile "$file" "$device"
